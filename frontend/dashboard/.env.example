# Copy to .env.local. These Firebase web identifiers are public configuration, not credentials.
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Never put a service-account key, access token, or Gemini API key in VITE_ variables.
