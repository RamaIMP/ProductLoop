 "derivation_rules": {
  "who_decides": "Gemini returns symptoms, context and user_intent. Code derives issue_type, severity and safety_flag so they are always consistent.",
  "issue_type_priority": [
   "heat_and_safety",
   "shaving_head_and_fitment",
   "noise_and_vibration",
   "power_and_charging",
   "shaving_performance",
   "cleaning_and_maintenance",
   "other_or_unclear"
  ],
  "issue_type": "Take the symptoms present. Choose the issue_type of the highest-severity symptom; break ties with issue_type_priority.",
  "severity": [
   "severity = highest default_severity among symptoms",
   "if persists_after_cleaning is yes and severity is low and issue_type is not cleaning_and_maintenance or other_or_unclear: severity = medium",
   "if issue_type is shaving_head_and_fitment, symptoms include head_loose, head_wobble, head_not_fitting or blade_unit_not_seated, and persists_after_cleaning is yes: severity = high (head cannot be secured; safety guide says do not use)",
   "if user_intent is ask_question: severity = low unless a safety symptom is present"
  ],
  "safety_flag": "true when severity is high (stop-use conditions from 03_safety_escalation.md)",
  "heat_wording": "Set excessive_heat only when the user says hot, too hot or burning. 'Warm' alone is normal per 04_operating_specs.md; ask one follow-up instead."
 },
 "confidence_rules": {
  "ask_follow_up_below": 0.6,
  "use_other_or_unclear_below": 0.4
 },
 "retrieval": {
  "filters": "product_model plus issue_type of the derived primary issue, plus any chunk that lists one of the symptoms",
  "when_severity_high": "always also retrieve every chunk with document_type safety_escalation",
  "when_other_or_unclear": "retrieve the general service chunks and ask one clarifying question"
 }
}