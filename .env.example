# Copy to .env and fill in. Never commit .env.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
BQ_DATASET=productloop
# Enable only after: cd backend && .venv/bin/python -m app.services.setup_bigquery
PRODUCTLOOP_BIGQUERY_ENABLED=0
# Optional persistent metadata/outbox path; default productloop/.runtime/lifecycle.sqlite3
PRODUCTLOOP_STATE_DB=
# sqlite keeps local development unchanged; firestore uses ADC/runtime identity.
PRODUCTLOOP_STATE_BACKEND=sqlite
PRODUCTLOOP_FIRESTORE_DATABASE=(default)
PRODUCTLOOP_FIRESTORE_NAMESPACE=productloop
GCS_MEDIA_BUCKET=
SESSION_BACKEND=memory
# Pick current Gemini and embedding model names from the Vertex AI model list.
GEMINI_MODEL_EXTRACT=
GEMINI_MODEL_CHAT=
GEMINI_MODEL_REASON=
EMBEDDING_MODEL=
