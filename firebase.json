{
  "hosting": [
    {
      "target": "consumer",
      "public": "frontend/consumer/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{"source": "**", "destination": "/index.html"}],
      "headers": [{"source": "**", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "X-Content-Type-Options", "value": "nosniff"}]}]
    },
    {
      "target": "dashboard",
      "public": "frontend/dashboard/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{"source": "**", "destination": "/index.html"}],
      "headers": [{"source": "**", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "X-Content-Type-Options", "value": "nosniff"}]}]
    }
  ]
}
